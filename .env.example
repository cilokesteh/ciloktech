# ═══════════════════════════════════════════════════════════
# CilokTech — Environment Variables
# Copy ke .env.local untuk development, set di Vercel dashboard untuk production.
# JANGAN commit .env / .env.local / .env.production.
# ═══════════════════════════════════════════════════════════

# Google Analytics 4 — Measurement ID
# Format: G-XXXXXXXXXX
# Default fallback di code: G-5NZBMX2RRF (Tuan boleh ganti kalo punya ID sendiri)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL — dipake buat canonical, OG, sitemap
NEXT_PUBLIC_SITE_URL=https://www.ciloktech.id

# OG endpoint rate limit (optional, request per minute per IP)
# Default 60 kalau unset. Bump untuk traffic lebih tinggi.
# OG_RATE_LIMIT_PER_MIN=60
